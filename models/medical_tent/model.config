<?xml version="1.0"?>
<model>
  <name>medical_tent</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    User-supplied medical/field-hospital tent (FBX -> OBJ). Mesh is Y-up in
    non-metric units; the model.sdf bakes a uniform scale (~0.30, height ~2.8 m)
    and a +90 deg X rotation to bring it Z-up onto the ground.
  </description>
</model>
